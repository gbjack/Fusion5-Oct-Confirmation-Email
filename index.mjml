<mjml lang="en" dir="ltr">
  <mj-head>

    <mj-title>You're confirmed and we can't wait to see you.</mj-title>
    <mj-preview>Your place is reserved for the Fusion5 executive roundtable in Melbourne.</mj-preview>

    <mj-attributes>
      <mj-all padding="0px" />
    </mj-attributes>

    <mj-font name="Calibre" href="https://fusion5-oct-confirmation-email.vercel.app/fonts/Calibre-Bold.woff2" />
    <mj-font name="Calibre" href="https://fusion5-oct-confirmation-email.vercel.app/fonts/Calibre-Bold.woff" />

    <mj-raw>
      <!--[if mso]>
        <style type="text/css">
          body, table, td, p, a, span, font, div, h1, h2, h3, h4, h5, h6 {
            font-family: Arial, sans-serif !important;
          }
        </style>
      <![endif]-->
    </mj-raw>

    <mj-style>
      * { -webkit-font-smoothing: antialiased !important;
      -moz-osx-font-smoothing: grayscale !important; }
      a[x-apple-data-detectors], u + .body-wrapper a, a.MsoHyperlink,
      a.MsoHyperlinkFollowed { color: inherit !important; text-decoration: none
      !important; }

      @media only screen and (max-width:480px) {
        .mobile-center table {
          margin: 0 auto !important;
          }
          .mobile-center div {
            text-align: center !important;
          }
        }
    </mj-style>

  </mj-head>

  <mj-body>
    <mj-section background-color="#FFFFFF">
      <mj-column>
        <mj-image src="images/hero-600x344.jpg" alt="Hero image" width="600px" />
      </mj-column>
    </mj-section>

    <mj-wrapper padding="60px 23px 0 23px">

        <mj-section>
            <mj-column>
                <mj-text color="#3F3B42" font-family="Calibre, Arial, sans-serif" font-size="21px" font-weight="normal" line-height="31px">
                    Hi [firstname,fallback=],
                    <br /><br />
                    <b>You're confirmed.</b>
                    <br /><br />
                    We're looking forward to welcoming you to an invitation&#8209;only executive roundtable hosted by Fusion5.
                    <br /><br />
                    On Thursday, 15 October, a select group of manufacturing and wholesale distribution leaders will come together at Society in Melbourne for an open conversation about navigating an increasingly complex operating environment.
                </mj-text>
            </mj-column>
        </mj-section>

        <mj-section padding="50px 0 50px 0">
            <mj-column>
                <mj-divider border-width="1px" border-style="solid" border-color="#3F3B42" />
            </mj-column>
        </mj-section>

         <mj-section>
            <mj-column>
                <mj-text color="#FF5C39" font-family="Calibre, Arial, sans-serif" font-size="40px" font-weight="bold" line-height="40px">
                    On The Agenda
                </mj-text>
            </mj-column>
        </mj-section>

        <mj-section padding="30px 0 30px 0">
            <mj-column>
                <mj-text color="#3F3B42" font-family="Calibre, Arial, sans-serif" font-size="21px" font-weight="normal" line-height="31px">
                    During lunch, we'll explore:
                </mj-text>
            </mj-column>
        </mj-section>

        <mj-section>
            <mj-column>
                <mj-text color="#FF5C39" font-family="Calibre, Arial, sans-serif" font-size="30px" font-weight="bold" line-height="45px">
                    Visibility to Act
                </mj-text>
                <mj-text color="#3F3B42" font-family="Calibre, Arial, sans-serif" font-size="21px" font-weight="normal" line-height="31px">
                    Turning operational insight into faster, more confident decisions.
                </mj-text>
                <mj-image src="images/img-agenda-1-554x297.png" alt="Agenda 1" width="554px" padding-top="20px" />
            </mj-column>
        </mj-section>

        <mj-section padding-top="60px">
            <mj-column>
                <mj-text color="#FF5C39" font-family="Calibre, Arial, sans-serif" font-size="30px" font-weight="bold" line-height="45px">
                    Confidence to Move
                </mj-text>
                <mj-text color="#3F3B42" font-family="Calibre, Arial, sans-serif" font-size="21px" font-weight="normal" line-height="31px">
                    Leading through uncertainty while protecting growth and profitability.
                </mj-text>
                <mj-image src="images/img-agenda-2-554x297.png" alt="Agenda 2" width="554px" padding-top="20px" />
            </mj-column>
        </mj-section>

        <mj-section padding-top="60px">
            <mj-column>
                <mj-text color="#FF5C39" font-family="Calibre, Arial, sans-serif" font-size="30px" font-weight="bold" line-height="45px">
                    Scaling Without Complexity
                </mj-text>
                <mj-text color="#3F3B42" font-family="Calibre, Arial, sans-serif" font-size="21px" font-weight="normal" line-height="31px">
                    Building an organisation that grows without losing control.
                </mj-text>
                <mj-image src="images/img-agenda-3-554x297.png" alt="Agenda 3" width="554px" padding-top="20px" />
            </mj-column>
        </mj-section>

        <mj-section padding-top="60px">
            <mj-column>
                <mj-text color="#FF5C39" font-family="Calibre, Arial, sans-serif" font-size="30px" font-weight="bold" line-height="45px">
                    AI in the Supply Chain
                </mj-text>
                <mj-text color="#3F3B42" font-family="Calibre, Arial, sans-serif" font-size="21px" font-weight="normal" line-height="31px">
                    Where AI is already being incorporated into business processes and what practical adoption looks like today.
                </mj-text>
                <mj-image src="images/img-agenda-4-554x297.png" alt="Agenda 4" width="554px" padding-top="20px" />
            </mj-column>
        </mj-section>

        <mj-section padding-top="60px">
            <mj-column>
                <mj-text color="#FF5C39" font-family="Calibre, Arial, sans-serif" font-size="30px" font-weight="bold" line-height="45px">
                    Rethinking KPIs and Industry Benchmarks
                </mj-text>
                <mj-text color="#3F3B42" font-family="Calibre, Arial, sans-serif" font-size="21px" font-weight="normal" line-height="31px">
                    How AI and changing operating models are reshaping the measures businesses use to track performance and success.
                </mj-text>
                <mj-image src="images/img-agenda-5-554x297.png" alt="Agenda 4" width="554px" padding-top="20px" />
            </mj-column>
        </mj-section>

        <mj-section padding="50px 0 60px 0">
            <mj-column>
                <mj-divider border-width="1px" border-style="solid" border-color="#3F3B42" />
            </mj-column>
        </mj-section>

        <mj-section>
            <mj-column padding="0 23px 30px 23px">
                <mj-text font-family="Calibre, Arial, sans-serif" font-size="40px" font-weight="bold" line-height="49px" color="#FF5C39">
                    Event Details
                </mj-text>
            </mj-column>
        </mj-section>

        <mj-section padding="0 23px 20px 23px">
            <mj-column width="48%" background-color="#F0EDF2" border-radius="14px" padding="20px 10px 20px 10px">
                <mj-image src="images/ico-25x28.png" alt="Calendar icon" width="25px" href="https://fusion5-oct-confirmation-email.vercel.app/images/event.ics" target="_blank" />
                <mj-spacer height="10px" />
                <mj-text align="center" color="#3F3B42" font-family="Calibre, Arial, sans-serif" font-size="22px" font-weight="medium" line-height="24px">
                    <a style="text-decoration: none; color: #3F3B42;" href="https://fusion5-oct-confirmation-email.vercel.app/images/event.ics" target="_blank">
                        <span style="white-space: nowrap;">Thursday, <br />15 October 2026</span>
                    </a>
                </mj-text>
            </mj-column>
            <mj-column width="4%">
                <mj-spacer height="20px" />
            </mj-column>
            <mj-column width="48%" background-color="#F0EDF2" border-radius="14px" padding="20px 10px 20px 10px">
                <mj-image src="images/ico-house-28x27.png" alt="Venue icon" width="28px" href="https://societyrestaurant.com/" target="_blank" />
                <mj-spacer height="10px" />
                <mj-text align="center" color="#3F3B42" font-family="Calibre, Arial, sans-serif" font-size="22px" font-weight="medium" line-height="24px">
                    <a style="text-decoration: none; color: #3F3B42;" href="https://societyrestaurant.com/" target="_blank">Society <br />Restaurant</a>
                </mj-text>
            </mj-column>
        </mj-section>

        <mj-section padding="0 23px 0 23px">
            <mj-column width="48%" background-color="#F0EDF2" border-radius="14px" padding="20px 10px 16px 10px">
                <mj-image src="images/ico-location-23x31.png" alt="Calendar icon" width="23px" href="https://www.google.com/maps?q=Society,+80+Collins+St,+Melbourne+VIC+3000&ftid=0x6ad643a48f60a7f3:0x81c05dce6b1cee4&entry=gps&shh=CAE&lucs=,100834230,94297699,94231188,94280568,47071704,94218641,94282134,94286869,100820247,100822504&g_ep=CAISEjI2LjMzLjEuOTYxODkxNDMyMBgAIIgnKl0sMTAwODM0MjMwLDk0Mjk3Njk5LDk0MjMxMTg4LDk0MjgwNTY4LDQ3MDcxNzA0LDk0MjE4NjQxLDk0MjgyMTM0LDk0Mjg2ODY5LDEwMDgyMDI0NywxMDA4MjI1MDRCAkFV&skid=7c277aa1-82a9-45d6-86d1-1290edb7c205&g_st=ic" target="_blank" />
                <mj-spacer height="10px" />
                <mj-text align="center" color="#3F3B42" font-family="Calibre, Arial, sans-serif" font-size="22px" font-weight="medium" line-height="24px">
                    <a style="text-decoration: none; color: #3F3B42;" href="https://www.google.com/maps?q=Society,+80+Collins+St,+Melbourne+VIC+3000&ftid=0x6ad643a48f60a7f3:0x81c05dce6b1cee4&entry=gps&shh=CAE&lucs=,100834230,94297699,94231188,94280568,47071704,94218641,94282134,94286869,100820247,100822504&g_ep=CAISEjI2LjMzLjEuOTYxODkxNDMyMBgAIIgnKl0sMTAwODM0MjMwLDk0Mjk3Njk5LDk0MjMxMTg4LDk0MjgwNTY4LDQ3MDcxNzA0LDk0MjE4NjQxLDk0MjgyMTM0LDk0Mjg2ODY5LDEwMDgyMDI0NywxMDA4MjI1MDRCAkFV&skid=7c277aa1-82a9-45d6-86d1-1290edb7c205&g_st=ic" target="blank">
                    <span style="white-space: nowrap;">80 Collins Street,</span> <br />Melbourne
                    </a>
                </mj-text>
            </mj-column>
            <mj-column width="4%">
                <mj-spacer height="20px" />
            </mj-column>
            <mj-column width="48%" background-color="#F0EDF2" border-radius="14px" padding="20px 10px 20px 10px">
                <mj-image src="images/ico-time-28x28.png" alt="Venue icon" width="28px" href="https://calendar.google.com/calendar/render?action=TEMPLATE&dates=20261015T010000Z%2F20261015T030000Z&details=Thank%20you%20for%20registering.%20We%20look%20forward%20to%20welcoming%20you%20to%20the%20Fusion5%20%2B%20NetSuite%20Executive%20Roundtable.%20This%20exclusive%20lunch%20brings%20together%20senior%20leaders%20across%20Manufacturing%2C%20Wholesale%20%26%20Distribution%20to%20discuss%20how%20AI%20is%20reshaping%20ERP%2C%20operations%20and%20business%20performance.%20You%27ll%20hear%20practical%20insights%20from%20Fusion5%20specialists%20and%20connect%20with%20peers%20facing%20similar%20challenges.%0A%0AEvent%20details%0ADate%3A%20Thursday%2C%2015%20October%202026%0ATime%3A%2012%3A00%20pm%20%E2%80%93%202%3A00%20pm%20%28please%20arrive%20from%2011%3A45%20am%29%0AVenue%3A%20Society%20Restaurant%2C%20Melbourne.%20%0AAddress%3A%2080%20Collin%20Street%2C%20Melbourne%2C%20VIC%203000&location=Society%20Restaurant.%2080%20Collins%20St%2C%20Melbourne%20VIC%203000.&text=Fusion5%20%2B%20NetSuite%20Executive%20Lunch%20-%20Visibility%20to%20Act.%20Confidence%20to%20Move." target="_blank" />
                <mj-spacer height="10px" />
                <mj-text align="center" color="#3F3B42" font-family="Calibre, Arial, sans-serif" font-size="22px" font-weight="medium" line-height="24px">
                    <a style="text-decoration: none; color: #3F3B42;" href="https://calendar.google.com/calendar/render?action=TEMPLATE&dates=20261015T010000Z%2F20261015T030000Z&details=Thank%20you%20for%20registering.%20We%20look%20forward%20to%20welcoming%20you%20to%20the%20Fusion5%20%2B%20NetSuite%20Executive%20Roundtable.%20This%20exclusive%20lunch%20brings%20together%20senior%20leaders%20across%20Manufacturing%2C%20Wholesale%20%26%20Distribution%20to%20discuss%20how%20AI%20is%20reshaping%20ERP%2C%20operations%20and%20business%20performance.%20You%27ll%20hear%20practical%20insights%20from%20Fusion5%20specialists%20and%20connect%20with%20peers%20facing%20similar%20challenges.%0A%0AEvent%20details%0ADate%3A%20Thursday%2C%2015%20October%202026%0ATime%3A%2012%3A00%20pm%20%E2%80%93%202%3A00%20pm%20%28please%20arrive%20from%2011%3A45%20am%29%0AVenue%3A%20Society%20Restaurant%2C%20Melbourne.%20%0AAddress%3A%2080%20Collin%20Street%2C%20Melbourne%2C%20VIC%203000&location=Society%20Restaurant.%2080%20Collins%20St%2C%20Melbourne%20VIC%203000.&text=Fusion5%20%2B%20NetSuite%20Executive%20Lunch%20-%20Visibility%20to%20Act.%20Confidence%20to%20Move." target="_blank">
                        12.00 - <br />2.00pm
                    </a>
                </mj-text>
            </mj-column>
        </mj-section>

        <mj-section padding="60px 0 60px 0">
            <mj-column>
                <mj-divider border-width="1px" border-style="solid" border-color="#3F3B42" />
            </mj-column>
        </mj-section>

        <mj-section padding="0 23px 0 23px">
            <mj-column width="48%">
                <mj-image src="images/img-add-calendar-267x52.png" alt="Add to Calendar" width="267px" href="https://fusion5-oct-confirmation-email.vercel.app/images/event.ics" target="_blank" />
            </mj-column>
            <mj-column width="4%">
                <mj-spacer height="20px" />
            </mj-column>
            <mj-column width="48%">
                <mj-image src="images/img-add-google-267x52.png" alt="Add to Google Calendar" width="267px" href="https://calendar.google.com/calendar/render?action=TEMPLATE&dates=20261015T010000Z%2F20261015T030000Z&details=Thank%20you%20for%20registering.%20We%20look%20forward%20to%20welcoming%20you%20to%20the%20Fusion5%20%2B%20NetSuite%20Executive%20Roundtable.%20This%20exclusive%20lunch%20brings%20together%20senior%20leaders%20across%20Manufacturing%2C%20Wholesale%20%26%20Distribution%20to%20discuss%20how%20AI%20is%20reshaping%20ERP%2C%20operations%20and%20business%20performance.%20You%27ll%20hear%20practical%20insights%20from%20Fusion5%20specialists%20and%20connect%20with%20peers%20facing%20similar%20challenges.%0A%0AEvent%20details%0ADate%3A%20Thursday%2C%2015%20October%202026%0ATime%3A%2012%3A00%20pm%20%E2%80%93%202%3A00%20pm%20%28please%20arrive%20from%2011%3A45%20am%29%0AVenue%3A%20Society%20Restaurant%2C%20Melbourne.%20%0AAddress%3A%2080%20Collin%20Street%2C%20Melbourne%2C%20VIC%203000&location=Society%20Restaurant.%2080%20Collins%20St%2C%20Melbourne%20VIC%203000.&text=Fusion5%20%2B%20NetSuite%20Executive%20Lunch%20-%20Visibility%20to%20Act.%20Confidence%20to%20Move." target="_blank" />
            </mj-column>
        </mj-section>

        <mj-section padding="60px 23px 60px 23px">
            <mj-column>
                <mj-text font-family="Calibre, Arial, sans-serif" font-size="21px" font-weight="normal" line-height="29px" color="#3F3B42" padding-bottom="30px">
                    We've intentionally kept the group small to encourage genuine discussion and meaningful peer-to-peer conversation.
                    <br /><br />
                    We're delighted to have you joining us.
                </mj-text>
                <mj-text font-family="Calibre, Arial, sans-serif" font-size="21px" font-weight="bold" line-height="29px" color="#3F3B42">
                    The Fusion5 Team
                </mj-text>
            </mj-column>
        </mj-section>

    </mj-wrapper>

    <mj-section padding="30px 23px 30px 23px" background-color="#000000">
        <mj-column width="48%" vertical-align="bottom" css-class="mobile-center">
            <mj-image src="images/img-logo-173x30.png" alt="Fusion5 + NetSuite logo" width="173px" align="left" />
        </mj-column>
        <mj-column width="4%">
            <mj-spacer height="20px" />
        </mj-column>
        <mj-column width="48%" vertical-align="bottom" css-class="mobile-center">
              <mj-text font-family="Calibre, Arial, sans-serif" font-size="12px" font-weight="normal" line-height="12px" color="#FFFFFF" align="right">
                <mj-raw>
                    <unsubscribe style="color: #ffffff; text-decoration: underline;">Unsubscribe</unsubscribe>&nbsp;&nbsp;|&nbsp;&nbsp;&copy; 2026 Fusion5 Limited
                </mj-raw>
              </mj-text>
        </mj-column>
    </mj-section>

  </mj-body>
</mjml>